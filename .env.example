NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creators_grow
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:8080
META_OAUTH_MODE=mock
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:3000/api/v1/social/meta/callback
ENCRYPTION_KEY=your-32-character-encryption-key-

# TikTok OAuth
TIKTOK_OAUTH_MODE=mock
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/v1/social/tiktok/callback

# AI Copilot
# Set AI_PROVIDER=gemini for production. Requires a valid GEMINI_API_KEY.
# Set AI_PROVIDER=mock for local development without a real key.
# WARNING: If AI_PROVIDER=gemini and GEMINI_API_KEY is missing or invalid,
# the server will return an error — it will NOT silently fall back to mock.
AI_PROVIDER=mock
GEMINI_API_KEY=
